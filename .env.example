# SAM 3 Server Configuration
# Model options: "facebook/sam3" or "vil-uob/sam3-litetext-s0"
MODEL_ID=vil-uob/sam3-litetext-s0

# Precision options: "fp16", "bf16", or "fp32"
PRECISION=fp16

# Device: "cuda" or "cpu"
DEVICE=cuda

# Performance & CUDA settings
ENABLE_TF32=true
ENABLE_CUDNN_BENCHMARK=true
ENABLE_WARMUP=true

# Inference Defaults
DEFAULT_SCORE_THRESHOLD=0.20
DEFAULT_MASK_THRESHOLD=0.50

# Server settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
